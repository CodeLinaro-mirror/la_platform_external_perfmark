// Include this target otherwise PerfMark will be no-op.
java_library {
    name: "perfmark-impl",
    srcs: [
        "src/main/java/io/perfmark/impl/SecretPerfMarkImpl.java",
    ],
    static_libs: [
        "jsr305",
        "perfmark-api-impl",
        "perfmark-api-link",
        "perfmark-api-stringfunction",
        "perfmark-api-tag",
        "perfmark-impl-generator",
        "perfmark-impl-mark",
        "perfmark-impl-mark-recorder",
        "perfmark-impl-storage",
        "perfmark-java6",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    java_version: "11",
    sdk_version: "current",
    min_sdk_version: "30",
    target: {
        windows: {
            enabled: true,
        },
    },
}

java_library {
    name: "perfmark-impl-mark-recorder",
    srcs: ["src/main/java/io/perfmark/impl/MarkRecorder.java"],
    static_libs: [
        "jsr305",
    ],
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    java_version: "11",
    sdk_version: "current",
    min_sdk_version: "30",
    visibility: ["//external/perfmark:__subpackages__"],
    target: {
        windows: {
            enabled: true,
        },
    },
}


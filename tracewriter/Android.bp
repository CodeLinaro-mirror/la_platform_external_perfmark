java_library {
    name: "perfmark-tracewriter",
    srcs: [
        "src/main/java/io/perfmark/tracewriter/*.java",
    ],
    static_libs: [
        "error_prone_annotations",
        "gson",
        "jsr305",
        "perfmark-impl-mark",
        "perfmark-impl-mark-list",
        "perfmark-impl-storage",
        "perfmark-java6",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    java_version: "11",
    sdk_version: "current",
    min_sdk_version: "30",
    target: {
        windows: {
            enabled: true,
        },
    },
}
